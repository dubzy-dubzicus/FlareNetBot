# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application/client ID from the same Discord app
DISCORD_APPLICATION_ID=
# Optional: register commands to a single guild for instant updates during development
DISCORD_GUILD_ID=

# RecFlare instance domain (no protocol)
RECFLARE_DOMAIN=recflare.net
# Embed accent color
RECFLARE_COLOR=#5865F2
# Request timeout / cache TTL in milliseconds
RECFLARE_TIMEOUT_MS=10000
RECFLARE_CACHE_TTL_MS=60000
